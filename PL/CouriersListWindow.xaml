<Window x:Class="PL.CouriersListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Couriers List" Height="500" Width="1000" MinWidth="800" MinHeight="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Couriers" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Click on a courier to view details" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Couriers ListView with styled GridView columns -->
        <ListView
                  Grid.Row="1"
                  ItemsSource="{Binding}" 
                  SelectionChanged="Couriers_ListView_SelectionChanged"
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch"
                  AlternationCount="2">
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <!-- Zebra striping for better readability -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                        <!-- Highlight inactive couriers -->
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <!-- Id -->
                    <GridViewColumn Header="Id" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" TextAlignment="Left"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Full Name -->
                    <GridViewColumn Header="Full Name" Width="150" DisplayMemberBinding="{Binding FullName}"/>

                    <!-- Phone -->
                    <GridViewColumn Header="Phone" Width="110" DisplayMemberBinding="{Binding Phone}"/>

                    <!-- Email -->
                    <GridViewColumn Header="Email" Width="200" DisplayMemberBinding="{Binding Email}"/>

                    <!-- Shipment Type -->
                    <GridViewColumn Header="Shipment Type" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShipmentType}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Max Distance -->
                    <GridViewColumn Header="Max Distance (km)" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaxDeliveryDistanceKm, TargetNullValue='(no limit)'}" 
                                           TextAlignment="Right" 
                                           Margin="0,0,5,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Active Status -->
                    <GridViewColumn Header="Active" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ActiveStatusTextBlockStyle}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Start Work Date -->
                    <GridViewColumn Header="Started" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StartWorkAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                           TextAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
